NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. The app does not use it; keep it out of the browser.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_ENABLE_GOOGLE=false

# Gmail drafts with the PDF attached (Settings > Email). Server only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GMAIL_TOKEN_KEY=

# Optional: log every timed call, not just the slow ones
PERF_LOG=
